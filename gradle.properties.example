# Copy to ~/.gradle/gradle.properties or export as ORG_GRADLE_PROJECT_* environment variables.
# Never commit real credentials to Git.

version=1.0.0
group=io.github.brody-0125

# Sonatype Central Portal (Maven Central) — https://central.sonatype.com/
mavenCentralUsername=
mavenCentralPassword=

# OpenPGP signing (required for Maven Central)
signing.keyId=
signing.password=
signing.secretKeyRingFile=

# In-memory signing for CI (alternative to secretKeyRingFile)
# signingInMemoryKey=
# signingInMemoryKeyPassword=
